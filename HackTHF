-- ============= CREATE TABS =============
local TabsData = {"Combat", "Visuals", "Movement", "World", "Misc"}
local TabButtons = {}

for _, tabName in ipairs(TabsData) do
    local TabButton = Instance.new("TextButton")
    TabButton.Name = tabName .. "Tab"
    TabButton.BackgroundColor3 = (tabName == CurrentTab) and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(50, 50, 50)
    TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabButton.TextSize = 12
    TabButton.Font = Enum.Font.Gotham
    TabButton.Text = tabName
    TabButton.BorderSizePixel = 0
    TabButton.Parent = TabsFrame
    
    TabButton.MouseButton1Click:Connect(function()
        CurrentTab = tabName
        
        -- Update all tab buttons
        for _, btn in ipairs(TabButtons) do
            btn.BackgroundColor3 = (btn.Name == tabName .. "Tab") and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(50, 50, 50)
        end
        
        -- Update content frames
        for _, content in ipairs(ContentFrame:GetChildren()) do
            if content:IsA("Frame") then
                content.Visible = (content.Name == tabName .. "Content")
            end
        end
    end)
    
    table.insert(TabButtons, TabButton)
end

